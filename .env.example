# Firebase client (web) config — public by design, safe to expose to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Travelpayouts Data API — server-only. Never prefix with NEXT_PUBLIC_.
# https://support.travelpayouts.com/hc/en-us/articles/203956163-Aviasales-Data-API
TRAVELPAYOUTS_TOKEN=

# Set to "true" to use the live Travelpayouts cash provider instead of mock
# cash data. Requires TRAVELPAYOUTS_TOKEN to also be set; otherwise the app
# silently falls back to mock cash data.
ENABLE_LIVE_CASH_PROVIDER=false

# Seats.aero Partner API — server-only. Never prefix with NEXT_PUBLIC_.
# Pro accounts may only call Cached Search / Bulk Availability, not Live
# Search (that requires a separate commercial agreement).
# https://developers.seats.aero
SEATS_AERO_API_KEY=

# Set to "true" to use the live Seats.aero award provider instead of mock
# award data. Requires SEATS_AERO_API_KEY to also be set; otherwise the app
# silently falls back to mock award data.
ENABLE_LIVE_AWARD_PROVIDER=false
